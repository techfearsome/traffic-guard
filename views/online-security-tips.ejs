    <style>
        /* ===== RESET & VARIABLES ===== */
        :root {
            --neon-cyan: #00F0FF;
            --neon-green: #0AFF60;
            --alert-red: #FF2A2A;
            --bg-dark: #020408;
            --bg-panel: #0A121E;
            --text-main: #E0E6ED;
            --text-muted: #6E7F96;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, .mono {
            font-family: 'Fira Code', monospace;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        /* ===== NAVBAR ===== */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(2, 4, 8, 0.95);
            border-bottom: 1px solid rgba(0, 240, 255, 0.2);
            backdrop-filter: blur(10px);
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 70px;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--neon-cyan);
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            position: relative;
        }

        .nav-links a:hover {
            color: var(--neon-cyan);
        }

        .nav-links a::before {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--neon-cyan);
            transition: width 0.3s;
        }

        .nav-links a:hover::before {
            width: 100%;
        }

        .cta-btn {
            padding: 10px 20px;
            background: transparent;
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
            font-family: 'Fira Code', monospace;
            font-weight: bold;
            font-size: 0.8rem;
            cursor: pointer;
            transition: 0.3s;
        }

        .cta-btn:hover {
            background: var(--neon-cyan);
            color: var(--bg-dark);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
        }

        .hamburger span {
            width: 25px;
            height: 2px;
            background: var(--neon-cyan);
        }

        /* ===== HERO ===== */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
            background: 
                radial-gradient(circle at 50% 50%, rgba(0, 240, 255, 0.08) 0%, transparent 60%),
                linear-gradient(to bottom, var(--bg-dark), #000);
            padding: 0 20px;
        }

        /* Grid Background Effect */
        .grid-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
        }

        .hero-content {
            max-width: 800px;
            z-index: 2;
        }

        .tag {
            display: inline-block;
            padding: 8px 16px;
            border: 1px solid var(--neon-green);
            color: var(--neon-green);
            font-size: 0.75rem;
            font-family: 'Fira Code', monospace;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            margin-bottom: 20px;
            line-height: 1.1;
        }

        .hero p {
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 40px;
        }

        /* ===== STATS BAR ===== */
        .stats-bar {
            background: var(--bg-panel);
            border-top: 1px solid #1a2b3c;
            border-bottom: 1px solid #1a2b3c;
            padding: 40px 20px;
        }

        .stats-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            text-align: center;
        }

        .stat-item h3 {
            font-size: 2.2rem;
            color: var(--text-main);
        }

        .stat-item p {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 5px;
        }

        /* ===== SECTIONS ===== */
        section {
            padding: 100px 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .section-header .line {
            width: 60px;
            height: 3px;
            background: var(--neon-cyan);
            margin: 0 auto;
        }

        /* ===== TIMELINE (Threat History) ===== */
        .history-section {
            background: linear-gradient(180deg, var(--bg-dark) 0%, #060e16 100%);
        }

        .timeline {
            position: relative;
            max-width: 900px;
            margin: 0 auto;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 100%;
            background: rgba(0, 240, 255, 0.2);
        }

        .timeline-item {
            display: flex;
            justify-content: flex-end;
            position: relative;
            margin-bottom: 60px;
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease;
        }

        .timeline-item.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .timeline-item:nth-child(even) {
            justify-content: flex-start;
        }

        .timeline-dot {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 16px;
            height: 16px;
            background: var(--neon-cyan);
            border-radius: 50%;
            border: 3px solid var(--bg-dark);
            z-index: 2;
        }

        .timeline-card {
            width: 42%;
            background: var(--bg-panel);
            padding: 25px;
            border: 1px solid rgba(0, 240, 255, 0.1);
            border-radius: 8px;
            position: relative;
        }

        .timeline-year {
            color: var(--neon-cyan);
            font-family: 'Fira Code', monospace;
            font-size: 1.2rem;
            margin-bottom: 10px;
            display: block;
        }

        .timeline-card h3 {
            font-size: 1.1rem;
            color: #fff;
            margin-bottom: 10px;
        }

        .timeline-card p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* ===== SECURITY TIPS (Legends style) ===== */
        .tips-section {
            background: var(--bg-panel);
        }

        .tips-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .tip-card {
            background: var(--bg-dark);
            padding: 30px;
            border: 1px solid #1a2b3c;
            border-radius: 12px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .tip-card:hover {
            border-color: var(--neon-cyan);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .tip-icon {
            font-size: 2.5rem;
            margin-bottom: 20px;
            display: inline-block;
        }

        .tip-card h3 {
            color: var(--neon-cyan);
            font-size: 1.1rem;
            margin-bottom: 12px;
        }

        .tip-card p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* ===== COMMON THREATS (Cards) ===== */
        .threats-section {
            background: linear-gradient(to bottom, var(--bg-panel), var(--bg-dark));
        }

        .threats-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .threat-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 20px;
            background: rgba(255, 42, 42, 0.05);
            border-left: 3px solid var(--alert-red);
            border-radius: 0 8px 8px 0;
        }

        .threat-icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .threat-info h4 {
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .threat-info p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* ===== QUOTE ===== */
        .quote-section {
            padding: 80px 20px;
            text-align: center;
            background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 20h20v20H20z' fill='%23ffffff' fill-opacity='0.02'/%3E%3C/svg%3E");
        }

        .quote-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .quote-text {
            font-family: 'Fira Code', monospace;
            font-size: 1.4rem;
            color: var(--text-main);
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .quote-author {
            color: var(--neon-cyan);
            font-weight: bold;
            font-size: 0.9rem;
            letter-spacing: 2px;
        }

        /* ===== FOOTER ===== */
        footer {
            background: #000;
            padding: 50px 20px;
            border-top: 1px solid #1a2b3c;
            text-align: center;
        }

        .footer-logo {
            font-size: 1.2rem;
            color: var(--text-main);
            margin-bottom: 20px;
            display: inline-block;
            font-family: 'Fira Code', monospace;
        }

        .socials {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .socials a {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .socials a:hover {
            color: var(--neon-cyan);
        }

        .copyright {
            color: #444;
            font-size: 0.75rem;
        }

        /* Back to Top */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 45px;
            height: 45px;
            background: var(--bg-panel);
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s;
            z-index: 99;
            font-size: 1.2rem;
        }

        .back-to-top.show {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            background: var(--neon-cyan);
            color: #000;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            .nav-links {
                position: fixed;
                top: 70px;
                left: 0;
                width: 100%;
                background: rgba(2, 4, 8, 0.98);
                flex-direction: column;
                align-items: center;
                padding: 30px 0;
                transform: translateY(-150%);
                transition: transform 0.4s ease;
                border-bottom: 1px solid var(--neon-cyan);
            }

            .nav-links.active {
                transform: translateY(0);
            }

            .hamburger {
                display: flex;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .timeline::before {
                left: 20px;
            }

            .timeline-item, .timeline-item:nth-child(even) {
                justify-content: flex-start;
                padding-left: 50px;
            }

            .timeline-dot {
                left: 20px;
            }

            .timeline-card {
                width: 100%;
            }

            .hero h1 {
                font-size: 2.5rem;
            }
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav id="navbar">
        <div class="nav-container">
            <a href="#" class="logo">CYBER<span style="color:#fff;">GUARD</span></a>
            <ul class="nav-links" id="navLinks">
                <li><a href="#home">Home</a></li>
                <li><a href="#evolution">Evolution</a></li>
                <li><a href="#defense">Defense</a></li>
                <li><a href="#threats">Threats</a></li>
            </ul>
            <button class="cta-btn" onclick="window.location.href='#defense'">PROTECT NOW</button>
            <div class="hamburger" id="hamburger">
                <span></span><span></span><span></span>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero" id="home">
        <div class="grid-bg"></div>
        <div class="hero-content">
            <span class="tag">SYSTEM STATUS: SECURE // PRIVACY ENABLED</span>
            <h1>Your Digital Life<br>Is Under Attack.</h1>
            <p>In an era of data mining and sophisticated malware, your smartphone is the only thing keeping your identity alive. Here is how to survive.</p>
            <a href="#defense" class="cta-btn" style="padding: 15px 40px; font-size: 1rem;">START PROTOCOL</a>
        </div>
    </section>

    <!-- Stats Bar -->
    <div class="stats-bar">
        <div class="stats-grid">
            <div class="stat-item fade-up">
                <h3>$4.35B</h3>
                <p>Avg Cost of Data Breach</p>
            </div>
            <div class="stat-item fade-up">
                <h3>3.5B</h3>
                <p>Smartphone Users</p>
            </div>
            <div class="stat-item fade-up">
                <h3>91%</h3>
                <p>Breaches involve Humans</p>
            </div>
            <div class="stat-item fade-up">
                <h3>1971</h3>
                <p>Year First Virus Created</p>
            </div>
        </div>
    </div>

    <!-- History Section (Timeline) -->
    <section class="history-section" id="evolution">
        <div class="container">
            <div class="section-header fade-up">
                <span class="mono" style="color:var(--neon-cyan)">LOG HISTORY</span>
                <h2>The Evolution of Threats</h2>
                <div class="line"></div>
            </div>

            <div class="timeline">
                <div class="timeline-item fade-up">
                    <div class="timeline-dot"></div>
                    <div class="timeline-card">
                        <span class="timeline-year">1990s</span>
                        <h3>The Early Scripts</h3>
                        <p>When the internet first connected homes, scripts were simple. PC viruses were annoying, but mobile phones were just "brick phones".</p>
                    </div>
                </div>

                <div class="timeline-item fade-up">
                    <div class="timeline-dot"></div>
                    <div class="timeline-card">
                        <span class="timeline-year">2005-2010</span>
                        <h3>The Smart Revolution</h3>
                        <p>With the iPhone and Android launch, hackers realized pocket computers could hold bank details. SMS Phishing ("Smishing") began here.</p>
                    </div>
                </div>

                <div class="timeline-item fade-up">
                    <div class="timeline-dot"></div>
                    <div class="timeline-card">
                        <span class="timeline-year">2015-2020</span>
                        <h3>The App Economy Wars</h3>
                        <p>Ad fraud, cryptojacking apps, and deep fake scams targeted users directly on their devices. Biometric data became a new target.</p>
                    </div>
                </div>

                <div class="timeline-item fade-up">
                    <div class="timeline-dot"></div>
                    <div class="timeline-card">
                        <span class="timeline-year">2024+</span>
                        <h3>AI-Powered Attacks</h3>
                        <p>Now, scammers use Generative AI to clone voices and bypass facial recognition. Security is no longer optional—it's warfare.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Best Practices Section (Tips) -->
    <section class="tips-section" id="defense">
        <div class="container">
            <div class="section-header fade-up">
                <span class="mono" style="color:var(--neon-green)">SECURITY PROTOCOLS</span>
                <h2>The Best Defense</h2>
                <div class="line" style="background:var(--neon-green)"></div>
            </div>

            <div class="tips-grid">
                <div class="tip-card fade-up">
                    <div class="tip-icon">🛡️</div>
                    <h3>MFA / 2FA is Mandatory</h3>
                    <p>Never rely on a password alone. Enable Two-Factor Authentication (preferably an App like Authy or Google Authenticator, not SMS) immediately.</p>
                </div>

                <div class="tip-card fade-up">
                    <div class="tip-icon">💀</div>
                    <h3>Password Manager</h3>
                    <p>If you are reusing passwords, stop now. Use a manager like Bitwarden or 1Password to generate unique, uncrackable keys for every site.</p>
                </div>

                <div class="tip-card fade-up">
                    <div class="tip-icon">🌐</div>
                    <h3>Virtual Private Network (VPN)</h3>
                    <p>Never open banking or sensitive data on public Wi-Fi. A VPN encrypts your connection so hackers on the same network can't see your traffic.</p>
                </div>

                <div class="tip-card fade-up">
                    <div class="tip-icon">⚠️</div>
                    <h3>Sideload Only from Trusted Sources</h3>
                    <p>On Android, disable "Install from Unknown Sources". On iOS, keep it locked down. Downloading APKs manually is how 60% of malware enters.</p>
                </div>

                <div class="tip-card fade-up">
                    <div class="tip-icon">🔄</div>
                    <h3>Update Your OS Instantly</h3>
                    <p>Those "System Update" prompts are patches for critical holes found by researchers. Do not delay—your vulnerability score drops instantly after updates.</p>
                </div>

                <div class="tip-card fade-up">
                    <div class="tip-icon">🔒</div>
                    <h3>Biometrics vs PIN</h3>
                    <p>Fingerprint/FaceID is fast but has risks. Set a complex 6-digit alphanumeric passcode as your fallback. It prevents unauthorized biometric scans.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Threat Types Section -->
    <section class="threats-section" id="threats">
        <div class="container">
            <div class="section-header fade-up">
                <span class="mono" style="color:var(--alert-red)">ALERT: KNOWN ATTACKS</span>
                <h2>How They Get In</h2>
                <div class="line" style="background:var(--alert-red)"></div>
            </div>

            <div class="threats-list">
                <div class="threat-item fade-up">
                    <div class="threat-icon">🎣</div>
                    <div class="threat-info">
                        <h4>Smishing (SMS Phishing)</h4>
                        <p>Fake texts claiming your package failed delivery or bank account is locked, prompting you to click a malicious link.</p>
                    </div>
                </div>

                <div class="threat-item fade-up">
                    <div class="threat-icon">👻</div>
                    <div class="threat-info">
                        <h4>Man-in-the-Middle (MitM)</h4>
                        <p>A hacker intercepts communication between your phone and a website, often on open Wi-Fi networks.</p>
                    </div>
                </div>

                <div class="threat-item fade-up">
                    <div class="threat-icon">🤖</div>
                    <div class="threat-info">
                        <h4>Vishing (Voice Phishing)</h4>
                        <p>Automated calls or real humans posing as IT support using AI voice cloning to steal your data over the phone.</p>
                    </div>
                </div>

                <div class="threat-item fade-up">
                    <div class="threat-icon">📷</div>
                    <div class="threat-info">
                        <h4>Stalkerware / Spyware</h4>
                        <p>Hidden apps that track your GPS location, listen to your microphone, and read your messages without permission.</p>
                    </div>
                </div>

                <div class="threat-item fade-up">
                    <div class="threat-icon">🪤</div>
                    <div class="threat-info">
                        <h4>Ransomware</h4>
                        <p>Malware that locks your phone screen or encrypts your photos/files, demanding payment (usually crypto) to restore access.</p>
                    </div>
                </div>

                <div class="threat-item fade-up">
                    <div class="threat-icon">🏴‍☠️</div>
                    <div class="threat-info">
                        <h4>Quishing (QR Codes)</h4>
                        <p>Malicious QR codes stuck over legitimate barcodes (like on parking meters) that lead directly to phishing sites.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Quote -->
    <section class="quote-section">
        <div class="quote-container fade-up">
            <p class="quote-text">"In today's world, privacy is power. Protecting your data isn't just about hiding things—it's about owning your own future."</p>
            <p class="quote-author">— EDWARD Snowden</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-logo">CYBER<span style="color:var(--neon-cyan)">GUARD</span></div>
        <div class="socials">
            <a href="#">Twitter/X</a>
            <a href="#">GitHub</a>
            <a href="#">Reddit</a>
        </div>
        <p class="copyright">&copy; 2026 CyberGuard Project. Unofficial Fan Page. Stay Safe Online.</p>
    </footer>

